# Your local model API. Any OpenAI-compatible /v1/chat/completions endpoint works:
# Ollama (http://localhost:11434/v1), LM Studio (http://localhost:1234/v1), llama.cpp server, vLLM...
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
# Only if your server needs one.
LLM_API_KEY=
# Set to "off" to skip scoring and report every title-matched job.
LLM_SCORING=on

# Optional notifications (macOS notification is always shown when running on a Mac).
# Phone push via https://ntfy.sh — pick a hard-to-guess topic name.
NTFY_TOPIC=
SLACK_WEBHOOK_URL=
